# Copied to .env by `make up`; docker compose reads it automatically.
JWT_SECRET=change-me-to-a-long-random-string
LOG_LEVEL=info

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=task_tracker
MYSQL_USER=tracker
MYSQL_PASSWORD=tracker
MYSQL_PORT=3306

REDIS_PORT=6379

API_PORT=8080
HEALTH_PORT=8081
METRICS_PORT=8082
